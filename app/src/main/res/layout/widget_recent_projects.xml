<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_recent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_folder" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Recent Projects"
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_recent_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:text="See All →"
            android:textColor="#8B949E"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Project 1 -->
    <LinearLayout
        android:id="@+id/widget_project_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_project_row_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_project_badge_1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_badge_code"
            android:padding="6dp"
            android:src="@drawable/ic_widget_code" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_project_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="orbit-ui"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_project_path_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="/Projects/orbit-ui"
                android:textColor="#6E7681"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_project_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="2h ago"
            android:textColor="#8B949E"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Project 2 -->
    <LinearLayout
        android:id="@+id/widget_project_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_project_row_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_project_badge_2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_badge_green"
            android:padding="6dp"
            android:src="@drawable/ic_widget_db" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_project_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="study-buddy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_project_path_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="/Projects/study-buddy"
                android:textColor="#6E7681"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_project_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="1d ago"
            android:textColor="#8B949E"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Project 3 -->
    <LinearLayout
        android:id="@+id/widget_project_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_project_row_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_project_badge_3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_badge_orange"
            android:padding="6dp"
            android:src="@drawable/ic_widget_branch" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_project_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="vision-ai"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_project_path_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="/Projects/vision-ai"
                android:textColor="#6E7681"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_project_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="3d ago"
            android:textColor="#8B949E"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
