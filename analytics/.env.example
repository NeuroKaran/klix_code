# ==============================================================================
# Umami Analytics Configuration for Klix Code
# ==============================================================================

# Your Umami Website ID (UUID generated in Umami Dashboard under Settings -> Websites)
# Example: VITE_UMAMI_WEBSITE_ID=e4a29c12-3456-7890-abcd-ef1234567890
VITE_UMAMI_WEBSITE_ID=your-umami-website-id-here

# Script URL:
# For Umami Cloud: https://cloud.umami.is/script.js
# For Self-hosted on Vercel: https://your-umami-instance.vercel.app/script.js
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Optional: Set specific domains to track (comma-separated). Leave empty to track current domain.
VITE_UMAMI_DOMAINS=klixcode.vercel.app
